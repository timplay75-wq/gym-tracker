# ─── Server ──────────────────────────────────────────
PORT=5000
# development | production. В development сервер отдаёт ссылку сброса пароля
# прямо в ответе API — в любом другом режиме этого не происходит.
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/gym-tracker

# ─── JWT ─────────────────────────────────────────────
# Обязателен. Без него jwt.sign падает — фолбэка на дефолтный секрет нет и быть не должно.
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d

# ─── URLs ────────────────────────────────────────────
BACKEND_URL=http://localhost:5000
# Куда возвращать пользователя после OAuth и на какой домен ведёт ссылка
# сброса пароля.
FRONTEND_URL=http://localhost:5173

# ─── CORS ────────────────────────────────────────────
# Список разрешённых origin через запятую
CORS_ORIGIN=http://localhost:5173

# ─── Почта (сброс пароля) ────────────────────────────
# Нужен ОДИН из трёх способов. При NODE_ENV != development без него
# /forgot-password возвращает 500 — ссылку с токеном он не отдаёт никогда.
#
# От кого приходит письмо (общее для всех способов):
MAIL_FROM="Gym Tracker" <noreply@example.com>

# Способ 1 — Resend (HTTP). Подходит для Vercel и другого serverless.
# Требует подтверждения своего домена: https://resend.com/domains
RESEND_API_KEY=

# Способ 2 — Brevo (HTTP). Тоже подходит для serverless и не требует
# домена: достаточно подтвердить один адрес отправителя.
BREVO_API_KEY=

# Способ 3 — SMTP. Только для обычного сервера, Docker или VPS.
# На Vercel и Lambda исходящие SMTP-соединения виснут по таймауту.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── Подписки ────────────────────────────────────────
# Секрет для HMAC-SHA256 подписи вебхука платёжного провайдера.
# Без него POST /api/subscriptions/webhook отклоняется с 503.
# Провайдер должен слать заголовок: x-webhook-signature: sha256=<hex>
SUBSCRIPTION_WEBHOOK_SECRET=

# ─── OAuth: Google ───────────────────────────────────
# 1. https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID
# 3. Authorized redirect URIs → http://localhost:5000/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OAuth: GitHub ───────────────────────────────────
# 1. https://github.com/settings/developers → New OAuth App
# 2. Homepage URL → http://localhost:5173
# 3. Authorization callback URL → http://localhost:5000/api/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── OAuth: Microsoft ───────────────────────────────
# 1. https://portal.azure.com → App registrations → New registration
# 2. Redirect URI → http://localhost:5000/api/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
